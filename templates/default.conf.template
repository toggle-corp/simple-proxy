server {
    listen 8001;

    location / {
        proxy_pass https://ifrc-translationapi.azurewebsites.net;
        proxy_set_header Host ifrc-translationapi.azurewebsites.net;
        include /etc/nginx/templates/proxy.conf;

        if ($request_method = OPTIONS) {
            add_header 'Access-Control-Allow-Origin' 'http://localhost:3000' always;
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS, PUT, PATCH, DELETE' always;
            add_header 'Access-Control-Allow-Headers' 'Origin, Content-Type, Accept, Authorization, X-Requested-With, X-Api-Key' always;
            add_header 'Access-Control-Allow-Credentials' 'true' always;
            add_header 'Vary' 'Origin' always;
            return 204;
        }
    }

}

